# Copy this file to .env and put your real keys inside.
# .env is git-ignored, so your keys stay private.

# ---- Phase 5: sirf Sunday (abhi default) ----
# 1 = PRABH mode ka switch band. Code hataya nahi gaya, bas band hai.
# "Prabh..." bolne par bhi mode sunday hi rahega.
PRABH_SUNDAY_ONLY=1
# TOOLS app shuru hote hi ON rahe? Default OFF — UI ka TOOLS toggle dabao.
# (Default OFF hi rakhna behtar hai. ON karoge to 30 minute baad apne aap OFF.)
PRABH_TOOLS_ON=0
# HUD window app shuru hote hi khule? Default 0 — sirf "hello sunday" par khulta hai.
PRABH_HUD_AT_START=0

# ---- Brain (free providers) ----
GROQ_API_KEY=
GEMINI_API_KEY=
# NVIDIA NIM — free trial 1000 credits. 'nvapi-' se shuru hoti hai.
# https://build.nvidia.com se milti hai. Credits khatam par app use band kar
# deti hai "credits khatam — nayi key chahiye" bol kar (agle din tak nahi).
NVIDIA_API_KEY=
# OpenRouter — https://openrouter.ai/keys. App SIRF ':free' model use karti hai.
# Paid model ki taraf kabhi request nahi jayegi.
OPENROUTER_API_KEY=

# ---- Voice (optional). Na ho to app edge-tts (free) use karega. ----
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Voice IDs. DONO mode female-only hai — male id ya male default kabhi use
# nahi hoga. Female id ki allowlist voice/tts_female.py me hai; list me nahi to
# app us provider ko chhod kar agle par chali jayegi.
# ElevenLabs: apni library me "female" filter laga kar id copy karo.
ELEVENLABS_VOICE_SUNDAY=
ELEVENLABS_VOICE_PRABH=

# Cartesia ki voice IDs (optional). 'simi' jaisi FEMALE voice ka id chahiye —
# /voices endpoint par gender check kar ke hi daalo, warna app use nahi karegi.
# Na ho to Cartesia skip ho jaati hai (koi galti nahi).
CARTESIA_VOICE_SUNDAY=
CARTESIA_VOICE_PRABH=
