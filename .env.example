# Copy this file to .env and put your real keys inside.
# .env is git-ignored, so your keys stay private.

# ---- Phase 5: sirf Jarvis (default mode) ----
# 1 = PRABH mode ka switch band. Code hataya nahi gaya, bas band hai.
# "Prabh..." bolne par bhi mode (id "sunday") hi rahega.
PRABH_SUNDAY_ONLY=1
# TOOLS app shuru hote hi ON rahe? Default OFF â€” UI ka TOOLS toggle dabao.
# (Default OFF hi rakhna behtar hai. ON karoge to 30 minute baad apne aap OFF.)
PRABH_TOOLS_ON=0
# HUD window app shuru hote hi khule? Default 0 - sirf "jarvis" par khulta hai.
PRABH_HUD_AT_START=0
# HUD kholne ka GLOBAL hotkey (poore Windows me, kisi app ki khidmat nahi).
# Format: ctrl+alt+<key> â€” key koi letter/1-9/F1-F24 ho. Default Ctrl+Alt+S.
# Galat ya khaali value par hotkey chalti hi nahi, app bilkul safe rehta hai.
# .env.example ka ye line comment kar do to shortcut sirf Desktop par rahega.
PRABH_HUD_HOTKEY=ctrl+alt+s

# ---- Wake word + command (Step 1 / Step 2) ----
# Wake word sunna band? Default chalu. 0 = "jarvis" sunna hi nahi hoga.
PRABH_WAKE=1
# Purane "sunday" shabd wapas chahu to 1. Default 0 = band.
PRABH_WAKE_LEGACY=0
# "Jarvis" ke baad aap CHUP kitni der rehne par command maana jayega (seconds).
# Default 2.0. Chhota karoge to beech me bolna ruk jayega; 3.0 se bada karoge
# to Jarvis zyada der intezaar karega. Maximum command 30 second (constant).
PRABH_CMD_SILENCE=1.2
# Vosk ko sirf tab chunk dena hai jab bol rahe ho (battery). Default 1 (ON).
# 0 = purana behaviour (har chunk Vosk ko) - sirf debug ke liye.
PRABH_VOSK_GATE=1
# Mic kholne ki koshish kitni baar (device busy / dusra app mic pakde ho).
PRABH_MIC_ATTEMPTS=3
# Har koshish ke beech ka wait (seconds).
PRABH_MIC_RETRY=1.2
# Mic kis Windows API se khule. Default WASAPI - MME se kachra audio aata
# tha (5-Oct: Vosk "hey"/"huh" sunta tha, "jarvis" kabhi nahi).
PRABH_WAKE_MIC_HOSTAPI=WASAPI
# Mic ka device number ya naam. Khaali = WASAPI ka default. Example: 9
PRABH_WAKE_MIC=
# Hamesha 0 rakho. 1 = har 3 second ek debug line logs/prabh.log me.
PRABH_WAKE_DEBUG=0

# ---- Tray (optional) ----
# Tray watchdog: Explorer ne icon nahi liya to app khud dobara add karta hai.
# 1 = chalu (default). Debug me band karna ho to 0.
PRABH_TRAY_WATCH=1

# ---- Brain (free providers) ----
GROQ_API_KEY=
GEMINI_API_KEY=
# NVIDIA NIM â€” free trial 1000 credits. 'nvapi-' se shuru hoti hai.
# https://build.nvidia.com se milti hai. Credits khatam par app use band kar
# deti hai "credits khatam â€” nayi key chahiye" bol kar (agle din tak nahi).
NVIDIA_API_KEY=
# OpenRouter â€” https://openrouter.ai/keys. App SIRF ':free' model use karti hai.
# Paid model ki taraf kabhi request nahi jayegi.
OPENROUTER_API_KEY=

# ---- Voice (optional). Na ho to app edge-tts (free) use karega. ----
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Voice IDs. DONO mode female-only hai â€” male id ya male default kabhi use
# nahi hoga. Female id ki allowlist voice/tts_female.py me hai; list me nahi to
# app us provider ko chhod kar agle par chali jayegi.
# ElevenLabs: apni library me "female" filter laga kar id copy karo.

# Cartesia ki voice IDs (optional). 'simi' jaisi FEMALE voice ka id chahiye â€”
# /voices endpoint par gender check kar ke hi daalo, warna app use nahi karegi.
# Na ho to Cartesia skip ho jaati hai (koi galti nahi).
# Web Search (SerpAPI) - optional
SERPAPI_API_KEY=

# Jarvis ki awaaz, female voice id (code sirf `*_VOICE_SUNDAY` naam padhta hai).
# ElevenLabs voice id (library me "female" filter laga kar copy karo).
ELEVENLABS_VOICE_SUNDAY=Qij2AC3uJWMKEDjKwcDy
# Cartesia female voice id (/voices par gender check kar ke daalo, warna skip).
CARTESIA_VOICE_SUNDAY=4459a9a5-69d6-4680-b970-e13dc51845b6
GITHUB_TOKEN_RACHIT=
