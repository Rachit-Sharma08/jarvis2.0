# Copy this file to .env and put your real keys inside.
# .env is git-ignored, so your keys stay private.

# ---- Phase 5: sirf Jarvis (default mode) ----
# 1 = PRABH mode ka switch band. Code hataya nahi gaya, bas band hai.
# "Prabh..." bolne par bhi mode (id "sunday") hi rahega.
JARVIS_SUNDAY_ONLY=1
# TOOLS app shuru hote hi ON rahe? Default OFF — UI ka TOOLS toggle dabao.
# (Naye user ke liye OFF hi theek hai. ON karne par auto-off tabhi lagega jab
# neeche JARVIS_TOOLS_AUTOOFF me 0 se bada number daalo.)
JARVIS_TOOLS_ON=0
# ALLOW/DENY card band? Default 1 = card ki zarurat nahi: gatekeeper ka code
# khud faisla karta hai (workspace ke andar chupchaap ALLOW, baaki DENY + ek
# line Hinglish wajah). 0 = purana card (screen par ALLOW/DENY, 60 second).
JARVIS_NO_CARDS=1
# Trust mode. 1 = ASK ko seedha ALLOW karo: koi card nahi, koi "ye allowed
# nahi" nahi (run_command, workspace ke bahar, naya app - sab chalega).
# Hard-block list (gatekeeper/.env delete, password file, registry, encoded
# download-run) phir bhi lagti hai - wo apna hi repo uda dene se bachati hai.
JARVIS_TRUST=0
# Simple tool ka jawab seedha (E-2): pehla tool call + single-kaam wala command
# (bina "aur/phir" ke) par tool ka result hi final jawab hai - LLM dobara nahi
# bulaya. ~2 second bachta hai aur LLM ka jhooth ("website khol diya" bina tool
# call) bhi nahi bolta. 0 = purana raasta (har tool ke baad LLM call).
JARVIS_DIRECT_REPLY=1
# HUD window app shuru hote hi khule? Default 0 - sirf "jarvis" par khulta hai.
JARVIS_HUD_AT_START=0
# HUD kholne ka GLOBAL hotkey (poore Windows me, kisi app ki khidmat nahi).
# Format: ctrl+alt+<key> — key koi letter/1-9/F1-F24 ho. Default Ctrl+Alt+S.
# Galat ya khaali value par hotkey chalti hi nahi, app bilkul safe rehta hai.
# .env.example ka ye line comment kar do to shortcut sirf Desktop par rahega.
JARVIS_HUD_HOTKEY=ctrl+alt+s

# ---- Wake word + command (Step 1 / Step 2) ----
# Wake word sunna band? Default chalu. 0 = "jarvis" sunna hi nahi hoga.
JARVIS_WAKE=1
# Purane "sunday" shabd wapas chahu to 1. Default 0 = band.
JARVIS_WAKE_LEGACY=0
# Wake ke baad "Ji, boliye" ki jagah chhota beep. Default 1, 0 = purana raasta.
JARVIS_WAKE_ACK_BEEP=1
# "Jarvis" ke baad aap CHUP kitni der rehne par command maana jayega (seconds).
# Default 2.0. Chhota karoge to beech me bolna ruk jayega; 3.0 se bada karoge
# to Jarvis zyada der intezaar karega. Maximum command 30 second (constant).
JARVIS_CMD_SILENCE=1.2
# Vosk ko sirf tab chunk dena hai jab bol rahe ho (battery). Default 1 (ON).
# 0 = purana behaviour (har chunk Vosk ko) - sirf debug ke liye.
JARVIS_VOSK_GATE=1
# Mic kholne ki koshish kitni baar (device busy / dusra app mic pakde ho).
JARVIS_MIC_ATTEMPTS=3
# Har koshish ke beech ka wait (seconds).
JARVIS_MIC_RETRY=1.2
# Mic kis Windows API se khule. Default WASAPI - MME se kachra audio aata
# tha (5-Oct: Vosk "hey"/"huh" sunta tha, "jarvis" kabhi nahi).
JARVIS_WAKE_MIC_HOSTAPI=WASAPI
# Mic ka device number ya naam. Khaali = WASAPI ka default. Example: 9
JARVIS_WAKE_MIC=
# Hamesha 0 rakho. 1 = har 3 second ek debug line logs/jarvis.log me.
JARVIS_WAKE_DEBUG=0

# ---- Tray (optional) ----
# Tray watchdog: Explorer ne icon nahi liya to app khud dobara add karta hai.
# 1 = chalu (default). Debug me band karna ho to 0.
JARVIS_TRAY_WATCH=1

# ---- Brain (free providers) ----
GROQ_API_KEY=
GEMINI_API_KEY=
# NVIDIA NIM — free trial 1000 credits. 'nvapi-' se shuru hoti hai.
# https://build.nvidia.com se milti hai. Credits khatam par app use band kar
# deti hai "credits khatam — nayi key chahiye" bol kar (agle din tak nahi).
NVIDIA_API_KEY=
# OpenRouter — https://openrouter.ai/keys. App SIRF ':free' model use karti hai.
# Paid model ki taraf kabhi request nahi jayegi.
OPENROUTER_API_KEY=

# ---- Voice (optional). Na ho to app edge-tts (free) use karega. ----
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Voice IDs. DONO mode female-only hai — male id ya male default kabhi use
# nahi hoga. Female id ki allowlist voice/tts_female.py me hai; list me nahi to
# app us provider ko chhod kar agle par chali jayegi.
# ElevenLabs: apni library me "female" filter laga kar id copy karo.

# Cartesia ki voice IDs (optional). 'simi' jaisi FEMALE voice ka id chahiye —
# /voices endpoint par gender check kar ke hi daalo, warna app use nahi karegi.
# Na ho to Cartesia skip ho jaati hai (koi galti nahi).
# Web Search (SerpAPI) - optional
SERPAPI_API_KEY=

# Jarvis ki awaaz, female voice id (code sirf `*_VOICE_SUNDAY` naam padhta hai).
# ElevenLabs voice id (library me "female" filter laga kar copy karo).
ELEVENLABS_VOICE_SUNDAY=Qij2AC3uJWMKEDjKwcDy
# Cartesia female voice id (/voices par gender check kar ke daalo, warna skip).
CARTESIA_VOICE_SUNDAY=4459a9a5-69d6-4680-b970-e13dc51845b6
GITHUB_TOKEN_RACHIT=

# ---- Naam ----
# Dikhne wala naam (window title, tray, HUD). Wake word alag hai - wo
# config_name.py ke WAKE_WORDS me hai, env se nahi badalta.
JARVIS_ASSISTANT_NAME=Jarvis
# Top bar / HUD par bada naam. Default J.A.R.V.I.S.
JARVIS_DISPLAY_NAME=J.A.R.V.I.S

# ---- HUD theme ----
# arc (default, 14-Oct se) ya neon (purana). URL me /?theme=neon bhi chalta hai.
JARVIS_HUD_THEME=arc

# ---- Workspace + tools ----
# PC tools isi folder ke andar chupchaap chalti hain. Khaali chhoda to app ke
# apne folder me kaam karegi - is liye poora path do.
JARVIS_WORKSPACE=D:\jarvis_workspace
# TOOLS ON karne ke kitne minute baad apne aap OFF ho. 0 = kabhi nahi (default).
JARVIS_TOOLS_AUTOOFF=0
# Alarm tool (JARVIS_ALARM_TOOL=1 se ON). Default 0 = band.
JARVIS_ALARM_TOOL=0

# ---- Mic / wake ke advanced knobs ----
# Khamoshi ka cut-off (RMS). Bada = sirf tez awaaz par trigger. Default 0.0075.
JARVIS_VAD=0.0075
# Mic ka gain: auto (default) | number (fixed) | 0/off (koi gain nahi).
JARVIS_WAKE_GAIN=auto
# auto gain ka target level. Default 0.12.
JARVIS_WAKE_GAIN_TARGET=0.12
# auto gain ki maximum gunjaish. Default 12.
JARVIS_WAKE_GAIN_MAX=12
# Command ke baad 12 second tak bina wake word sunna (default 0 = band).
JARVIS_HOT_WINDOW=0
# Hot window kitne second. Default 12.
JARVIS_HOT_WINDOW_SECONDS=12
# TTS ke baad mic ko itni der aur band rakho (echo na aaye). Default 0.4.
JARVIS_TAIL_GUARD=0.4
# Windows audio enhancements (Realtek AEC) shared mode me mic daba dete hain.
# auto = shared dead ho to exclusive (APO bypass); 1 = hamesha exclusive;
# 0 = hamesha shared. Exclusive mic Teams/Zoom se lock ho sakta hai.
JARVIS_MIC_EXCLUSIVE=auto
# "Ji, boliye" ke baad command sunne ka chhota window (seconds). Default 0.18.
JARVIS_ACK_PEEK=0.18

# ---- STT / voice ke advanced knobs ----
# Command ka STT. Default groq-whisper (sirf jab GROQ_API_KEY ho).
JARVIS_STT_MODEL=groq-whisper
# Groq key na ho to local faster-whisper (free, offline). auto = key ho to
# Groq, warna local; local = hamesha offline; groq = sirf cloud; off = local band.
JARVIS_STT_LOCAL=auto
# Local model ka folder. Khaali = models/faster-whisper-small (gitignored).
JARVIS_STT_LOCAL_MODEL=
# CPU threads. Default 4 (i5-1145G7 ke 4 physical cores).
JARVIS_STT_THREADS=4
# Local STT ka ceiling (seconds). CPU par ~2x realtime. Default 75.
JARVIS_STT_LOCAL_TIMEOUT=75
# Local STT ki language. en = Hinglish Latin me rehti hai + 5s tez. Khaali = detect.
JARVIS_STT_LANG=en
# Ek STT call ka timeout (seconds). Default 6.
JARVIS_STT_TIMEOUT=6
# STT retry kitni baar. Default 1.
JARVIS_STT_RETRIES=1
# Awaaz me kitne character bolne hain (uske baad chhota). Default 220.
JARVIS_VOICE_MAX=220
# Awaaz me pehle kitne poore vaakya. Default 2.
JARVIS_VOICE_SENTENCES=2
# Output speaker ka naam (khaali = Windows default). List: python -m desktop.playback --list
JARVIS_SPEAKER=
# Output sample rate. Default 32000.
JARVIS_SPEAKER_RATE=32000

# ---- Vision (default OFF) ----
# 1 = har command se pehle camera se owner match. Default 0 - camera khulta hi nahi.
JARVIS_VISION=0
# Match ka cut-off. Khaali = identity.DEFAULT_THRESHOLD. Guess mat karo - enroll karke tune karo.
JARVIS_VISION_THRESHOLD=
# Camera index (0 = Windows default).
JARVIS_VISION_CAM=0
JARVIS_VISION_WIDTH=640
JARVIS_VISION_HEIGHT=480
# Enroll me kitne frames. Default 15.
JARVIS_VISION_SAMPLES=15

# ---- Debug ----
# Log folder. Khaali = <repo>/logs. Test suite isi ko temp par bhejti hai.
JARVIS_LOG_DIR=
